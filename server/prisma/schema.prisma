generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  BREAKDOWN
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceRequestType {
  BREAKDOWN
  PREVENTIVE
  IMPROVEMENT
}

enum MaintenanceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  password_hash String?
  role      Role
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  requestedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceRequestRequester")
  reviewedMaintenanceRequests  MaintenanceRequest[] @relation("MaintenanceRequestReviewer")
  decisionHistoryEntries       DecisionHistory[]
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]
}

model Location {
  id          Int                        @id @default(autoincrement())
  name        String                     @unique
  isActive    Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  equipment   Equipment[]
  historyFrom EquipmentLocationHistory[] @relation("HistoryFromLocation")
  historyTo   EquipmentLocationHistory[] @relation("HistoryToLocation")
}

model EquipmentCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]
}

model Equipment {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  serialNumber String?
  purchaseDate        DateTime?
  purchaseCost        Decimal?  @db.Decimal(12, 2)
  warrantyStartDate   DateTime?
  warrantyExpiryDate  DateTime?
  name         String
  description  String?
  status       EquipmentStatus @default(ACTIVE)
  criticality  Criticality
  departmentId Int
  locationId   Int
  categoryId   Int
  isDeactivated Boolean   @default(false)
  deactivatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department   Department @relation(fields: [departmentId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])
  category     EquipmentCategory @relation(fields: [categoryId], references: [id])
  locationHistory EquipmentLocationHistory[]
  maintenanceRequests MaintenanceRequest[]

  @@index([departmentId])
  @@index([locationId])
  @@index([categoryId])
  @@index([isDeactivated, status])
}

model EquipmentLocationHistory {
  id             Int      @id @default(autoincrement())
  equipmentId    Int
  fromLocationId Int?
  toLocationId   Int
  changedAt      DateTime @default(now())

  equipment    Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  fromLocation Location?  @relation("HistoryFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location   @relation("HistoryToLocation", fields: [toLocationId], references: [id])

  @@index([equipmentId, changedAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  entityType String
  entityId   Int
  summary    String
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MaintenanceRequest {
  id                   Int                      @id @default(autoincrement())
  requestType          MaintenanceRequestType
  status               MaintenanceRequestStatus @default(SUBMITTED)
  equipmentId          Int
  requesterId          Int
  description          String
  criticality          Criticality
  reviewerId           Int?
  decisionReason       String?
  problem              String?
  proposedSolution     String?
  expectedBenefit      String?
  outcome              String?
  implementationStatus String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  equipment       Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  requester       User              @relation("MaintenanceRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer        User?             @relation("MaintenanceRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decisionHistory DecisionHistory[]

  @@index([equipmentId, createdAt])
  @@index([requesterId, createdAt])
  @@index([reviewerId])
  @@index([status, createdAt])
}

model DecisionHistory {
  id             Int                      @id @default(autoincrement())
  requestId      Int
  previousStatus MaintenanceRequestStatus
  newStatus      MaintenanceRequestStatus
  actorId        Int
  comment        String?
  createdAt      DateTime                 @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId])
}
