
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  password_hash String?
  role      Role
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  equipment Equipment[]
}

model Location {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  equipment Equipment[]
  historyFrom EquipmentLocationHistory[] @relation("HistoryFromLocation")
  historyTo   EquipmentLocationHistory[] @relation("HistoryToLocation")
}

model EquipmentCategory {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  equipment Equipment[]
}

model Equipment {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  name         String
  description  String?
  status       EquipmentStatus @default(ACTIVE)
  criticality  Criticality
  departmentId Int
  locationId   Int
  categoryId   Int
  isDeactivated Boolean   @default(false)
  deactivatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  department   Department @relation(fields: [departmentId], references: [id])
  location     Location @relation(fields: [locationId], references: [id])
  category     EquipmentCategory @relation(fields: [categoryId], references: [id])
  locationHistory EquipmentLocationHistory[]
  
  @@index([departmentId])
  @@index([locationId])
  @@index([categoryId])
}

model EquipmentLocationHistory {
  id             Int      @id @default(autoincrement())
  equipmentId    Int
  fromLocationId Int?
  toLocationId   Int
  changedAt      DateTime @default(now())

  equipment    Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  fromLocation Location?  @relation("HistoryFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location   @relation("HistoryToLocation", fields: [toLocationId], references: [id])

  @@index([equipmentId, changedAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}