generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
  VIEWER
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  BREAKDOWN
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceRequestType {
  BREAKDOWN
  PREVENTIVE
  IMPROVEMENT
}

enum NotificationKind {
  REMINDER
  OVERDUE
  ALERT
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum MaintenanceOccurrenceStatus {
  PENDING
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum MaintenanceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String
  password_hash String?
  role          Role
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs                    AuditLog[]
  requestedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceRequestRequester")
  reviewedMaintenanceRequests  MaintenanceRequest[] @relation("MaintenanceRequestReviewer")
  decisionHistoryEntries       DecisionHistory[]
  assignedWorkOrders           WorkOrder[]          @relation("WorkOrderTechnician")
  createdWorkOrders            WorkOrder[]          @relation("WorkOrderAssigner")
  maintenancePlans             MaintenancePlan[]    @relation("MaintenancePlanTechnician")
  notificationRecipients      NotificationRecipient[]
  completedOccurrences        MaintenanceOccurrence[] @relation("MaintenanceOccurrenceCompletedBy")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment   Equipment[]
  historyFrom EquipmentLocationHistory[] @relation("HistoryFromLocation")
  historyTo   EquipmentLocationHistory[] @relation("HistoryToLocation")
}

model EquipmentCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]
}

model Equipment {
  id                 Int             @id @default(autoincrement())
  code               String          @unique
  serialNumber       String?
  purchaseDate       DateTime?
  purchaseCost       Decimal?        @db.Decimal(12, 2)
  warrantyStartDate  DateTime?
  warrantyExpiryDate DateTime?
  name               String
  description        String?
  status             EquipmentStatus @default(ACTIVE)
  criticality        Criticality
  departmentId       Int
  locationId         Int
  categoryId         Int
  isDeactivated      Boolean         @default(false)
  deactivatedAt      DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  department          Department                 @relation(fields: [departmentId], references: [id])
  location            Location                   @relation(fields: [locationId], references: [id])
  category            EquipmentCategory          @relation(fields: [categoryId], references: [id])
  locationHistory     EquipmentLocationHistory[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  maintenancePlans    MaintenancePlan[]

  @@index([departmentId])
  @@index([locationId])
  @@index([categoryId])
  @@index([isDeactivated, status])
}

model EquipmentLocationHistory {
  id             Int      @id @default(autoincrement())
  equipmentId    Int
  fromLocationId Int?
  toLocationId   Int
  changedAt      DateTime @default(now())

  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  fromLocation Location? @relation("HistoryFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location  @relation("HistoryToLocation", fields: [toLocationId], references: [id])

  @@index([equipmentId, changedAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  entityType String
  entityId   Int
  summary    String
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MaintenanceRequest {
  id                   Int                      @id @default(autoincrement())
  requestType          MaintenanceRequestType
  status               MaintenanceRequestStatus @default(SUBMITTED)
  equipmentId          Int
  requesterId          Int
  description          String
  criticality          Criticality
  reviewerId           Int?
  decisionReason       String?
  problem              String?
  proposedSolution     String?
  expectedBenefit      String?
  outcome              String?
  implementationStatus String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  equipment       Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  requester       User              @relation("MaintenanceRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer        User?             @relation("MaintenanceRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decisionHistory DecisionHistory[]
  workOrder       WorkOrder?

  @@index([equipmentId, createdAt])
  @@index([requesterId, createdAt])
  @@index([reviewerId])
  @@index([status, createdAt])
}

model DecisionHistory {
  id             Int                      @id @default(autoincrement())
  requestId      Int
  previousStatus MaintenanceRequestStatus
  newStatus      MaintenanceRequestStatus
  actorId        Int
  comment        String?
  createdAt      DateTime                 @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId])
}

model WorkOrder {
  id                   Int             @id @default(autoincrement())
  workOrderNumber      String          @unique
  maintenanceRequestId Int             @unique
  equipmentId          Int
  status               WorkOrderStatus @default(OPEN)
  maintenanceOccurrenceId Int?

  assignedTechnicianId Int?
  assignedById         Int?
  assignedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  closedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceRequest    MaintenanceRequest    @relation(fields: [maintenanceRequestId], references: [id], onDelete: Restrict)
  equipment             Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  maintenanceOccurrence MaintenanceOccurrence? @relation("WorkOrderOccurrence", fields: [maintenanceOccurrenceId], references: [id], onDelete: SetNull)
  assignedTechnician    User?                 @relation("WorkOrderTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  assignedBy            User?                 @relation("WorkOrderAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([maintenanceOccurrenceId])
  @@index([equipmentId, createdAt])
  @@index([assignedTechnicianId, status])
  @@index([status, createdAt])
}

model MaintenancePlan {
  id                   Int                  @id @default(autoincrement())
  equipmentId          Int
  activity             String
  instructions         String?
  frequency            MaintenanceFrequency
  assignedTechnicianId Int?
  lastCompletedAt      DateTime?
  nextDueDate          DateTime
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  equipment          Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  assignedTechnician User?                @relation("MaintenancePlanTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  occurrences        MaintenanceOccurrence[]

  @@index([equipmentId, isActive])
  @@index([assignedTechnicianId, isActive])
  @@index([nextDueDate])
}

model MaintenanceOccurrence {
  id               Int                         @id @default(autoincrement())
  maintenancePlanId Int
  dueDate          DateTime
  status           MaintenanceOccurrenceStatus @default(PENDING)
  completedAt      DateTime?
  completedById    Int?
  workPerformed    String?
  remarks          String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  maintenancePlan  MaintenancePlan @relation(fields: [maintenancePlanId], references: [id], onDelete: Restrict)
  completedBy      User?            @relation("MaintenanceOccurrenceCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  linkedWorkOrder  WorkOrder[]      @relation("WorkOrderOccurrence")
  notifications    Notification[]

  @@unique([maintenancePlanId, dueDate])
  @@index([maintenancePlanId, dueDate])
  @@index([status, dueDate])
}

model Notification {
  id              Int             @id @default(autoincrement())
  key             String          @unique
  occurrenceId    Int?
  kind            NotificationKind
  dueDate         DateTime
  title           String
  message         String
  createdAt       DateTime        @default(now())

  occurrence      MaintenanceOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  recipients      NotificationRecipient[]

  @@unique([occurrenceId, kind, dueDate])
  @@index([kind, dueDate])
}

model NotificationRecipient {
  id            Int       @id @default(autoincrement())
  notificationId Int
  userId        Int
  isRead        Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead])
}

model SchedulerRun {
  id        Int      @id @default(autoincrement())
  jobName   String
  runDate   DateTime
  createdAt DateTime @default(now())

  @@unique([jobName, runDate])
}

model WorkOrderNumberCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}
